# AsterMem environment variables — copy to .env and fill in only the providers you use.
#
# Each entry notes the provider id it feeds, which is the id you select in Settings and the key
# used in config.yaml. Keys set here are picked up automatically at startup; you can also enter
# them in the web UI instead, in which case this file is unnecessary.
#
# builtin, lmstudio and ollama need no key: they run against a local model or a local server.

# --- Chat and embedding providers ---

# Anthropic Claude (provider: anthropic)
ANTHROPIC_API_KEY=

# Alibaba Cloud Model Studio (provider: dashscope)
DASHSCOPE_API_KEY=

# DeepSeek (provider: deepseek)
DEEPSEEK_API_KEY=

# Google Gemini (provider: google)
GOOGLE_API_KEY=

# MiniMax (provider: minimax)
MINIMAX_API_KEY=

# Moonshot AI / Kimi (provider: moonshot)
MOONSHOT_API_KEY=

# OpenAI (provider: openai)
OPENAI_API_KEY=

# OpenRouter (provider: openrouter)
OPENROUTER_API_KEY=

# Claude via PipeLLM (provider: pipellm_claude)
PIPELLM_API_KEY=

# SiliconFlow (provider: siliconflow)
SILICONFLOW_API_KEY=

# TokenDance (provider: tokendance)
TOKENDANCE_API_KEY=

# Volcengine Ark (provider: volces)
VOLCES_API_KEY=

# xAI Grok (provider: xai)
XAI_API_KEY=

# Xiaomi MiMo (provider: xiaomi)
XIAOMI_API_KEY=

# Zhipu AI (provider: zhipu)
ZHIPU_API_KEY=

# --- Coding-plan subscriptions ---
# Flat-rate plans sold separately from the pay-per-token APIs above. Each needs its own
# subscription; the key is not interchangeable with the vendor's regular API key.

# Alibaba Cloud Coding Plan (provider: aliyun_coding)
ALIYUN_CODING_API_KEY=

# Kimi Code Plan (provider: kimi_coding)
KIMI_CODING_API_KEY=

# MiniMax Token Plan (provider: minimax_coding)
MINIMAX_CODING_API_KEY=

# Volcengine Coding Plan (provider: volces_coding)
VOLCES_CODING_API_KEY=

# Xiaomi MiMo Token Plan (provider: xiaomi_coding)
XIAOMI_CODING_API_KEY=

# Zhipu GLM Coding Plan (provider: zhipu_coding)
ZHIPU_CODING_API_KEY=

# --- Gateway ---

# Asterove (provider: asterove)
ASTEROVE_API_KEY=

# --- Scanner defence ---
# Only relevant when the instance answers traffic from the internet. Probes for software AsterMem
# does not run (/.env, /.git, /wp-admin) are answered with an empty 404 instead of the SPA, and an
# address that keeps probing stops being answered for a while. Request volume is never a signal:
# an AI agent calling the API in bursts is the normal workload here.

# Set to 0 to answer every request, including probes.
ASTERMEM_SCAN_GUARD=1

# Reverse proxies whose X-Forwarded-For may be believed. Anything else is read as the caller
# itself, so a scanner cannot name a third party and get it blocked. Defaults to loopback, which is
# correct when nginx or Caddy runs on the same host.
ASTERMEM_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Addresses that are never blocked, on top of loopback and private ranges. Worth setting to your
# own fixed address if you administer the instance from one.
ASTERMEM_ALLOWED_IPS=
