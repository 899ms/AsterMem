# AsterMem environment variables (copy to .env and fill in; only the providers you actually use are required)

# Alibaba Bailian（provider: bailian）
DASHSCOPE_API_KEY=

# OpenRouter（provider: openrouter）
OPENROUTER_API_KEY=

# Google AI（provider: googleai）
GOOGLE_API_KEY=

# Asterove（provider: asterove）
ASTEROVE_API_KEY=
