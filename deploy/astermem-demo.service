[Unit]
Description=AsterMem public read-only demo
Documentation=https://github.com/Asterove/AsterMem
After=network-online.target
Wants=network-online.target
# The data directory is a tmpfs mount; starting before it is ready would seed the
# library onto the real disk and then have it shadowed by the mount.
RequiresMountsFor=/opt/astermem/data

[Service]
Type=exec
WorkingDirectory=/opt/astermem
Environment=ASTERMEM_DEMO_MODE=1
Environment=ASTERMEM_PORT=8768
# Caddy is the only way in; binding to loopback stops visitors from reaching the
# origin on :8768 and skipping TLS and the proxy's security headers.
Environment=ASTERMEM_HOST=127.0.0.1
# config.yaml lives on the tmpfs too: ProtectSystem=strict makes the checkout read-only,
# and regenerating defaults each boot is exactly what a demo wants.
Environment=ASTERMEM_CONFIG=/opt/astermem/data/config.yaml
# Embedding weights are fetched once and are far too large for the tmpfs, which would also mean
# re-downloading them on every restart, so they live on the real disk instead of under HOME
# (ProtectHome makes that unreachable anyway).
Environment=ASTERMEM_MODEL_CACHE=/opt/astermem/models
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/astermem/venv/bin/python /opt/astermem/server.py
Restart=always
RestartSec=5

# Hardening: the demo answers anonymous public traffic, so the process gets no more
# than it needs. Only the data tmpfs and the model cache are writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/opt/astermem/data
ReadWritePaths=/opt/astermem/models

[Install]
WantedBy=multi-user.target
